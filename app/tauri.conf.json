{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Konverter",
  "version": "0.1.0",
  "identifier": "org.audiokonverter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace ui",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --workspace ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audio Konverter",
        "width": 980,
        "height": 680,
        "minWidth": 520,
        "minHeight": 460,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Convert audio files with ffmpeg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "German"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMxRjdEMDRGRDkxNDYzMkEKUldRcVl4VFpUOUQzTVdCVE12SmI4V0pxek5WdGpBaWsycVY0RnFELytSZ0tyMGNsWUs1bU9ZR3IK",
      "endpoints": [
        "https://github.com/Olcay91/Audio-Konverter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
